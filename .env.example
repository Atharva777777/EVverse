# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets.

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend (consumed by Next.js via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Open Charge Map API Key (Optional)
# Obtain free from https://openchargemap.org/site/profile/applications
# If omitted or unavailable, QuantEV automatically falls back to the Kaggle baseline dataset.
OPEN_CHARGE_MAP_API_KEY=

# Monad Testnet Payment Configuration (Chain ID 10143)
# REQUIRED: The on-chain recipient wallet address for EVverse stall reservations & charging payments.
# Example: 0xYourTreasuryOrOperatorAddress
NEXT_PUBLIC_MONAD_PAYMENT_RECIPIENT_ADDRESS=
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# Alchemy Monad Testnet RPC (Backend only — do NOT use NEXT_PUBLIC_ prefix)
# When configured, backend payment verification & status checks route via:
# https://monad-testnet.g.alchemy.com/v2/<ALCHEMY_API_KEY> (Chain ID 10143)
# If omitted or unreachable, EVverse automatically falls back to public Monad RPC.
ALCHEMY_API_KEY=

